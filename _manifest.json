{
  "manifest_version": 2,
  "id": "xingranya.maibot-voice-reply",
  "name": "语音回复",
  "version": "1.0.0",
  "description": "把机器人的文字回复自动转成语音发送。支持本地离线 TTS（cosyvoice.cpp）、SiliconFlow、小米 MiMo 五种引擎，带频率控制、群排除、内容过滤与音频后处理。",
  "author": {
    "name": "xingranya",
    "url": "https://github.com/xingranya"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/xingranya/maibot-voice-reply",
    "homepage": "https://github.com/xingranya/maibot-voice-reply",
    "issues": "https://github.com/xingranya/maibot-voice-reply/issues"
  },
  "host_application": {
    "min_version": "1.4.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.23.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": ["send.custom", "send.text", "llm.generate"],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "audio-lines",
      "background": "#7C5CFF"
    }
  },
  "changelog": "CHANGELOG.md"
}
